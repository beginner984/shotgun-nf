params {
    // User input/output
    input  = "samplesheet.csv"
    outdir = "results"

    // Databases - replace these with local paths
    checkm2_db           = "/path/to/checkm2/uniref100.KO.1.dmnd"
    card_db              = "/path/to/CARD/localDB"
    kraken2_db           = "/path/to/kraken2_db"
    krona_taxonomy       = "/path/to/krona_taxonomy"
    metaphlan_db_dir     = "/path/to/metaphlan_db"
    metaphlan_index      = "mpa_vJun23_CHOCOPhlAnSGB_202307"
    strainphlan_pkl      = "/path/to/metaphlan_db/mpa_vJun23_CHOCOPhlAnSGB_202307.pkl"
    humann_nucleotide_db = "/path/to/chocophlan"
    humann_protein_db    = "/path/to/uniref"
    humann_sif           = "/path/to/humann.sif"

    // Optional modules
    skip_host_removal = true
    run_strainphlan   = false
}

process {
    executor = "local"
}
