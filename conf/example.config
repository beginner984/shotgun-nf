params {
    // Required input/output
    input  = "samplesheet.csv"
    outdir = "results"

    // Optional host removal
    skip_host_removal = true
    host_index = null

    // Required databases/containers - user must edit these paths
    checkm2_db = "/path/to/checkm2/uniref100.KO.1.dmnd"
    card_db = "/path/to/CARD/localDB"

    kraken2_db = "/path/to/kraken2/database"
    krona_taxonomy = "/path/to/krona_taxonomy"

    metaphlan_db_dir = "/path/to/metaphlan/database"
    metaphlan_index = "mpa_vJun23_CHOCOPhlAnSGB_202307"
    strainphlan_pkl = "/path/to/metaphlan/database/mpa_vJun23_CHOCOPhlAnSGB_202307.pkl"

    humann_nucleotide_db = "/path/to/humann/chocophlan"
    humann_protein_db = "/path/to/humann/uniref"
    humann_metaphlan_db_dir = "/path/to/metaphlan/database"
    humann_metaphlan_index = "mpa_vJun23_CHOCOPhlAnSGB_202307"
    humann_sif = "/path/to/containers/humann_3.9.sif"

    antismash_sif = "/path/to/containers/antismash.sif"

    // MAG filtering thresholds
    min_completeness = 50
    max_contamination = 10

    skip_krona = false
}
